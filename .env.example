# Copy to .env and fill in. Never commit .env.
# Supabase → Project Settings. URL = https://YOUR-PROJECT.supabase.co (nothing after .co).
# Key = the publishable key (or the legacy "anon" key), never the secret key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Turn on once you have a paid Apple Developer account and have configured Apple in Supabase Auth.
EXPO_PUBLIC_ENABLE_APPLE_SIGNIN=false
# Optional: an iCloud link to a ready-made PerkScan Shortcut, shown on the Connect texts screen.
EXPO_PUBLIC_SHORTCUT_URL=

# Optional: anonymous usage analytics (PostHog). Leave empty to turn analytics off completely.
# Only the events in src/domain/analyticsEvents.ts are sent — no personal data. Users can opt out in Settings.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Only for scripts/tests on your computer. NEVER prefix with EXPO_PUBLIC_ and never ship in the app.
# SUPABASE_SERVICE_ROLE_KEY=
